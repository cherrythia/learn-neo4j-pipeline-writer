# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
WRITER_APP_ENV=dev

# LLM (see docs/adr/0003-llm-provider-abstraction.md)
WRITER_LLM_PROVIDER=anthropic          # anthropic | fake
WRITER_LLM_MODEL=claude-sonnet-5-5
WRITER_ANTHROPIC_API_KEY=
WRITER_LLM_EFFORT=high                 # low | medium | high | xhigh | max
WRITER_LLM_FALLBACKS=true              # server-side fallback on safety refusals
WRITER_LLM_MAX_ATTEMPTS=2
WRITER_LLM_CACHE_DIR=data/cache/llm
WRITER_SELF_CONSISTENCY_RUNS=3         # 1 to save cost while developing

# Stores
WRITER_NEO4J_URI=bolt://localhost:7687
WRITER_NEO4J_USER=neo4j
WRITER_NEO4J_PASSWORD=change-me-neo4j   # min 8 chars (Neo4j 5)
WRITER_GOVERNANCE_DB_URL=sqlite:///./governance.sqlite
# or MySQL from docker compose:
# WRITER_GOVERNANCE_DB_URL=mysql+pymysql://writer:dev-writer-password@127.0.0.1:3306/governance

# ---- Local demo infrastructure (docker compose). Dev-only values; change for anything shared.
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_WRITER_PASSWORD=dev-writer-password    # governance DB owner
MYSQL_READER_PASSWORD=dev-reader-password    # read-only on demo_compliance
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=dev-superset-password  # used by both mock and real Superset
SUPERSET_SECRET_KEY=dev-only-superset-secret-key-change-me
